# BOM Risk Analyzer — 环境变量配置模板
# 复制此文件为 .env 并填入实际的 API Key

# === 数据库 ===
DATABASE_URL=sqlite:///data/market_risk.db

# === Mouser API ===
# 免费注册: https://www.mouser.com/api-search/
# 不配置则 Mouser 数据源不生效（LCSC 仍可用）
MOUSER_API_KEY=

# === LCSC / JLCPCB API ===
# 免费、无需认证，默认启用
LCSC_ENABLED=true
LCSC_REQUEST_DELAY=0.55

# === DigiKey API ===
DIGIKEY_ENABLED=true
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# === LLM（行情情报智能体） ===
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514